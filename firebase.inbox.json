{
  "hosting": {
    "site": "just-dee-dee-inbox",
    "public": "inbox-public",
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
          }
        ]
      }
    ],
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/check-firebase-project.cjs\" \"$GCLOUD_PROJECT\""
    ]
  }
}
